

clean_df = df.copy()


clean_df.columns = clean_df.columns.str.strip()


clean_df["Order_Date"] = pd.to_datetime(
    clean_df["Order_Date"],
    errors="coerce"
)


clean_df["Quantity"] = pd.to_numeric(
    clean_df["Quantity"],
    errors="coerce"
)


clean_df["Price"] = (
    clean_df["Price"]
    .astype(str)
    .str.replace("₹", "", regex=False)
    .str.replace(",", "", regex=False)
    .str.strip()
)

clean_df["Price"] = pd.to_numeric(
    clean_df["Price"],
    errors="coerce"
)


clean_df["Category"] = clean_df["Category"].fillna("Unknown")


clean_df["Quantity"] = clean_df["Quantity"].fillna(
    clean_df["Quantity"].median()
)


clean_df["Price"] = clean_df["Price"].fillna(
    clean_df["Price"].median()
)


calculated_total = clean_df["Quantity"] * clean_df["Price"]

clean_df["Total"] = clean_df["Total"].fillna(
    calculated_total
)


clean_df = clean_df.drop_duplicates()



print("========== CLEANED DATA ==========")

print("\nDataset Shape:")
print(clean_df.shape)

print("\nMissing Values:")
print(clean_df.isna().sum())

print("\nDuplicate Rows:")
